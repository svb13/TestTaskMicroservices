{
  "ConnectionStrings": {
    "UsersDb": "Data Source=users.db"
  },
  "Jwt": {
    "Issuer": "Nemetscheck.UserDataAccessService",
    "Audience": "Nemetscheck.Api",
    "ExpirationMinutes": 60
  },
  "ImageStorage": {
    "RootPath": "uploads",
    "MaxBytes": 5242880
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
