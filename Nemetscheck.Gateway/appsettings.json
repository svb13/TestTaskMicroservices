{
  "ReverseProxy": {
    "Routes": {
      "users": {
        "ClusterId": "user-data-access",
        "Match": { "Path": "/api/users/{**catch-all}" }
      },
      "tokens": {
        "ClusterId": "user-data-access",
        "Match": { "Path": "/api/tokens/{**catch-all}" }
      },
      "dice-rolls": {
        "ClusterId": "operative",
        "Match": { "Path": "/api/dice-rolls/{**catch-all}" }
      }
    },
    "Clusters": {
      "user-data-access": {
        "HealthCheck": {
          "Active": { "Enabled": true, "Interval": "00:00:30", "Path": "/health" }
        },
        "Destinations": { "primary": { "Address": "http://localhost:5073/" } }
      },
      "operative": {
        "HealthCheck": {
          "Active": { "Enabled": true, "Interval": "00:00:30", "Path": "/health" }
        },
        "Destinations": { "primary": { "Address": "http://localhost:5291/" } }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*"
}
